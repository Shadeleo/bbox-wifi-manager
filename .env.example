# Copie ce fichier en .env et remplis les valeurs.

# ── Box ───────────────────────────────────────────────────────────────────────
BBOX_HOST=192.168.1.254
BBOX_PASSWORD=ton_mot_de_passe_admin

# ── Application ───────────────────────────────────────────────────────────────
# "development" (défaut) ou "production".
# En production, SECRET_KEY devient obligatoire : l'app refuse de démarrer sans.
APP_ENV=development

# Clé de signature des sessions Flask. Sans elle, une clé aléatoire est générée
# à chaque démarrage et toutes les sessions sont invalidées au redémarrage.
# Génère-la avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Port d'écoute (0.0.0.0 : accessible depuis tout le réseau local).
PORT=5000

# DEBUG écrit les corps de requêtes et les jetons CSRF dans les journaux.
# Garde INFO en production.
LOG_LEVEL=INFO

# ── Sécurité ──────────────────────────────────────────────────────────────────
# Vérification du certificat TLS lors de l'authentification auprès de
# mabbox.bytel.fr, où transite le mot de passe. Ne passe à 0 qu'en dernier
# recours, si ta box redirige vers un hôte au certificat invalide.
BBOX_VERIFY_TLS=1

# Passe à 1 derrière un reverse-proxy HTTPS uniquement (sinon, plus de session).
SESSION_COOKIE_SECURE=0

# Collecte périodique de la consommation WAN en tâche de fond.
ENABLE_POLLER=1
